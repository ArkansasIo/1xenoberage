# Copy to .env before starting: cp .env.example .env
# Replace all example credentials before exposing the server to the internet.
MYSQL_DATABASE=xenoberage
MYSQL_USER=xenoberage
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

DB_HOST=db
DB_PORT=3306
DB_NAME=xenoberage
DB_USER=xenoberage
DB_PASSWORD=replace-with-a-long-random-password
DB_PREFIX=
ADODB_CRYPT_KEY=replace-with-a-random-32-byte-or-longer-secret
HTTP_PORT=8080
